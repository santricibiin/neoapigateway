generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id              Int      @id @default(1)
  secretKey       String?
  pin             String?
  /// none | dana | nobu
  qrisProvider    String   @default("none") @db.VarChar(20)
  /// Raw payload QRIS statis (EMVCo)
  qrisStatic      String?  @db.Text
  /// Masa berlaku QRIS invoice (menit)
  qrisTtlMinutes  Int      @default(5)
  /// Secret untuk autentikasi callback Android notification forwarder
  forwarderSecret String?  @db.VarChar(200)
  /// Aktifkan kode unik 3 digit pada nominal QRIS
  uniqueCodeEnabled Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  active    Boolean  @default(true)
  products  Token[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Token {
  id           Int           @id @default(autoincrement())
  categoryId   Int?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sku          String?       @unique @db.VarChar(50)
  name         String        @db.VarChar(200)
  model        String
  description  String?       @db.Text
  price        Decimal
  /// Harga modal internal, tidak ditampilkan ke pembeli
  costPrice    Decimal       @default(0) @db.Decimal(18, 2)
  stockMode    String        @default("counted") @db.VarChar(20)
  stock        Int           @default(0)
  sold         Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  orders       PaymentOrder[]

  @@index([categoryId, active, createdAt])
}

model Transaction {
  id             Int      @id @default(autoincrement())
  reference      String?  @unique @db.VarChar(50)
  buyerName      String   @db.VarChar(200)
  buyerEmail     String   @db.VarChar(320)
  tokenId        Int
  token          Token    @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  productName    String?  @db.VarChar(200)
  productSku     String?  @db.VarChar(50)
  qty            Int      @default(1)
  unitPrice      Decimal? @db.Decimal(18, 2)
  amount         Decimal
  status         String   @default("pending")
  failureReason  String?  @db.Text
  expiresAt      DateTime?
  paidAt         DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([tokenId, createdAt])
  @@index([buyerEmail, createdAt])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentOrder {
  id             String        @id @default(cuid())
  invoice        String        @unique @db.VarChar(40)
  /// pending | processing | paid | expired | failed
  status         String        @default("pending") @db.VarChar(20)
  amount         Int
  qty            Int           @default(1)
  unitPrice      Int
  /// Snapshot harga modal saat invoice dibuat
  unitCost       Int           @default(0)
  productName    String        @db.VarChar(200)
  productSku     String?       @db.VarChar(50)
  buyerPhone     String?       @db.VarChar(24)
  qrisProvider   String        @db.VarChar(20)
  qrisPayload    String        @db.Text
  tokenId        Int
  token          Token         @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  paymentEventId String?       @unique
  paymentEvent   PaymentEvent? @relation(fields: [paymentEventId], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  paidAt         DateTime?
  delivered      String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, amount, expiresAt])
  @@index([tokenId, status])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  provider  String   @db.VarChar(20)
  pkg       String   @db.VarChar(120)
  name      String?  @db.VarChar(80)
  title     String?  @db.VarChar(500)
  text      String   @db.Text
  subtext   String?  @db.Text
  bigtext   String?  @db.Text
  infotext  String?  @db.Text
  amount    Int?
  account   String?  @db.VarChar(40)
  raw       String   @db.Text
  matched   Boolean  @default(false)
  order     PaymentOrder?
  createdAt DateTime @default(now())

  @@index([matched, amount, createdAt])
  @@index([provider, amount, createdAt])
}
