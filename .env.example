DATABASE_URL="mysql://root:@localhost:3306/neo"
BANDEL_UPSTREAM="https://bandelbanget.xyz"
PUBLIC_API_BASE="http://localhost:3000"
PUBLIC_BRAND_NAME="Neo API Gateway"

# WAJIB: secret untuk menandatangani session cookie admin (min 32 karakter)
# Generate: openssl rand -base64 48
# Deploy script auto-generate ini, tapi untuk dev lokal set manual
SESSION_SECRET=""

# WAJIB: secret untuk autentikasi callback Android notification forwarder
# Callback akan menolak request jika secret ini kosong
# Deploy script auto-generate ini
PAYMENT_FORWARD_SECRET=""

# Opsional: password admin untuk seed (deploy script auto-generate)
# Dev default: admin123
ADMIN_PASS=""
